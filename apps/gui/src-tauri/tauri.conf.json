{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSM GUI Proof",
  "version": "0.1.0-alpha.5",
  "identifier": "com.sleepymario.wsm.proof",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhackSmacker \u2014 GUI proof",
        "width": 900,
        "height": 850
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}