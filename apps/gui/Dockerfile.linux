FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive CARGO_BUILD_JOBS=2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config libwebkit2gtk-4.1-dev libxdo-dev libssl-dev librsvg2-dev libayatana-appindicator3-dev rustc cargo nodejs npm xvfb xauth dbus-x11 python3-selenium imagemagick && rm -rf /var/lib/apt/lists/*
WORKDIR /proof
