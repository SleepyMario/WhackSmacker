# Copy to a protected .env.production (mode 0600). The example image tag is
# configurable. Versioned production releases never follow the daily latest tag.
WHACKSMACKER_IMAGE=docker.io/sleepiestmario/whacksmacker:0.1.0-alpha.3
WHACKSMACKER_BIND_ADDRESS=127.0.0.1
WHACKSMACKER_PUBLIC_URL=https://whacksmacker.example.invalid
WHACKSMACKER_SECURE_COOKIES=true
WHACKSMACKER_SESSION_TTL=86400
WHACKSMACKER_TRUST_PROXY=true
DATABASE_URL=postgresql://whacksmacker:REPLACE_ME@postgres:5432/whacksmacker
POSTGRES_DB=whacksmacker
POSTGRES_USER=whacksmacker
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
