{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whacksmacker.com/schemas/canonical-cast-v2.schema.json",
  "title": "WhackSmacker strengthened canonical cast",
  "type": "object",
  "required": ["schemaVersion", "cast", "deckPersonPool", "activeCast"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "cast": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/person" }
    },
    "deckPersonPool": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/castId" }
    },
    "activeCast": {
      "type": "object",
      "required": ["schemaVersion", "progression"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "progression": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/castId" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "castId": {
      "type": "string",
      "pattern": "^CAST-[0-9]{3}$"
    },
    "substantiveText": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "age",
        "gender",
        "origin",
        "residence",
        "dailyRole",
        "relationshipStatus",
        "household",
        "relevantFamily",
        "background",
        "interests",
        "personality",
        "castRelationships",
        "recurringContexts",
        "continuityNotes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/castId" },
        "displayName": { "$ref": "#/$defs/substantiveText" },
        "traditionalDisplayName": { "$ref": "#/$defs/substantiveText" },
        "simplifiedDisplayName": { "$ref": "#/$defs/substantiveText" },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "gender": {
          "enum": ["female", "male", "nonbinary"]
        },
        "origin": { "$ref": "#/$defs/substantiveText" },
        "residence": { "$ref": "#/$defs/substantiveText" },
        "dailyRole": { "$ref": "#/$defs/substantiveText" },
        "relationshipStatus": { "$ref": "#/$defs/substantiveText" },
        "household": { "$ref": "#/$defs/substantiveText" },
        "relevantFamily": { "$ref": "#/$defs/substantiveText" },
        "background": { "$ref": "#/$defs/substantiveText" },
        "interests": { "$ref": "#/$defs/substantiveText" },
        "personality": { "$ref": "#/$defs/substantiveText" },
        "castRelationships": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationship" }
        },
        "recurringContexts": { "$ref": "#/$defs/substantiveText" },
        "continuityNotes": { "$ref": "#/$defs/substantiveText" }
      },
      "dependentRequired": {
        "traditionalDisplayName": ["simplifiedDisplayName"],
        "simplifiedDisplayName": ["traditionalDisplayName"]
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["targetCastId", "type"],
      "properties": {
        "targetCastId": { "$ref": "#/$defs/castId" },
        "type": {
          "enum": [
            "parent",
            "child",
            "sibling",
            "spouse",
            "partner",
            "grandparent",
            "grandchild",
            "other-family",
            "friend",
            "neighbour",
            "colleague",
            "classmate",
            "teacher",
            "student",
            "supervisor",
            "employee",
            "mentor",
            "mentee",
            "housemate",
            "acquaintance",
            "professional-contact",
            "service-provider",
            "customer",
            "supplier",
            "client",
            "volunteer-colleague",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "other" } },
            "required": ["type"]
          },
          "then": { "required": ["description"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
